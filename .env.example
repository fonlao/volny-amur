DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
PUBLIC_BASE_URL=https://example.com

EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=mailbox@example.com
EMAIL_HOST_PASSWORD=application-password
DEFAULT_FROM_EMAIL=mailbox@example.com
LEAD_NOTIFICATION_EMAIL=manager@example.com

YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
TELEGRAM_ADMIN_CHAT_ID=replace-with-operator-chat-id
TELEGRAM_MINIAPP_URL=https://example.com/
